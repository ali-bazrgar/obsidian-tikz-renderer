{
  "name": "tikz-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Professional TikZ/PGF renderer for Obsidian Desktop",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production && node scripts/verify-build.mjs",
    "dev": "node esbuild.config.mjs development",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.5",
    "@types/node": "22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "1.8.7",
    "typescript": "5.8.3"
  }
}
